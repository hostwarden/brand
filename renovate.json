    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:monthly",
    "group:all",
    ":semanticCommitTypeAll(build)"
  ],
  "enabledManagers": ["github-actions", "pip_requirements"],
  "minimumReleaseAge": "7 days"
}
